{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"name": "Base",
					"color": "#FFFFFF"
				},
				{
					"slug": "contrast",
					"name": "Heading",
					"color": "#14202E"
				},
				{
					"slug": "accent-1",
					"name": "Brand",
					"color": "#1F3A5F"
				},
				{
					"slug": "accent-2",
					"name": "Brand dark",
					"color": "#142840"
				},
				{
					"slug": "accent-3",
					"name": "Accent",
					"color": "#E0A526"
				},
				{
					"slug": "accent-4",
					"name": "Muted text",
					"color": "#667385"
				},
				{
					"slug": "accent-5",
					"name": "Light background",
					"color": "#F3F5F8"
				},
				{
					"slug": "accent-6",
					"name": "Border",
					"color": "#DDE2E8"
				},
				{
					"slug": "body-text",
					"name": "Body text",
					"color": "#33404F"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "manrope",
					"name": "Manrope",
					"fontFamily": "\"Manrope\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"https://fonts.gstatic.com/s/manrope/v20/xn7gYHE41ni1AdIRggexSg.woff2"
							]
						},
						{
							"fontFamily": "Manrope",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"https://fonts.gstatic.com/s/manrope/v20/xn7gYHE41ni1AdIRggexSg.woff2"
							]
						},
						{
							"fontFamily": "Manrope",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"https://fonts.gstatic.com/s/manrope/v20/xn7gYHE41ni1AdIRggexSg.woff2"
							]
						}
					]
				},
				{
					"slug": "inter",
					"name": "Inter",
					"fontFamily": "\"Inter\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "400",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [
								"https://fonts.gstatic.com/s/inter/v20/UcCM3FwrK3iLTcvneQg7Ca725JhhKnNqk4j1ebLhAm8SrXTc2dtRipWF.woff2"
							]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"https://fonts.gstatic.com/s/inter/v20/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7.woff2"
							]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"https://fonts.gstatic.com/s/inter/v20/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7.woff2"
							]
						},
						{
							"fontFamily": "Inter",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"https://fonts.gstatic.com/s/inter/v20/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem"
				},
				{
					"slug": "medium",
					"name": "Body",
					"size": "1.0625rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.25rem"
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "clamp(1.375rem, 1.2rem + 0.7vw, 1.75rem)"
				},
				{
					"slug": "xx-large",
					"name": "Huge",
					"size": "clamp(1.75rem, 1.35rem + 1.6vw, 2.5rem)"
				}
			]
		},
		"custom": {
			"radius": {
				"card": "12px",
				"button": "8px"
			},
			"space": {
				"section": "clamp(56px, 2.5rem + 3.5vw, 96px)"
			}
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--body-text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontWeight": "700",
					"lineHeight": "1.15"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "clamp(1.75rem, 1.35rem + 1.6vw, 2.5rem)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "clamp(1.375rem, 1.2rem + 0.7vw, 1.75rem)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.25rem"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent-1)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent-1)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": {
					"radius": "var(--wp--custom--radius--button)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--inter)",
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-2)"
					}
				}
			}
		},
		"blocks": {
			"core/details": {
				"border": {
					"radius": "var(--wp--custom--radius--card)",
					"width": "1px",
					"color": "var(--wp--preset--color--accent-6)"
				},
				"spacing": {
					"padding": {
						"top": "14px",
						"bottom": "14px",
						"left": "18px",
						"right": "18px"
					}
				}
			},
			"core/image": {
				"border": {
					"radius": "var(--wp--custom--radius--card)"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--accent-3)",
						"width": "4px"
					}
				}
			}
		}
	}
}